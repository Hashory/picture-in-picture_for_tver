{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["chrome"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"useUnknownInCatchVariables": true,
		"allowImportingTsExtensions": true
	},
	"include": ["source", "tsdown.config.ts"]
}
